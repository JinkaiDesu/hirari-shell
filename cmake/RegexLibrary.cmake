include(FetchContent)
file(READ "${CMAKE_CURRENT_LIST_DIR}/regex-library.lock.json" HIRARI_REGEX_LOCK)
string(JSON HIRARI_REGEX_URL GET "${HIRARI_REGEX_LOCK}" url)
string(JSON HIRARI_REGEX_SHA256 GET "${HIRARI_REGEX_LOCK}" sha256)
# Pinned upstream source, statically linked into the host capability module.
# FETCHCONTENT_SOURCE_DIR_PCRE2 permits an already verified offline source copy.
set(PCRE2_BUILD_PCRE2_8 ON CACHE BOOL "" FORCE)
set(PCRE2_BUILD_PCRE2_16 OFF CACHE BOOL "" FORCE)
set(PCRE2_BUILD_PCRE2_32 OFF CACHE BOOL "" FORCE)
set(PCRE2_BUILD_PCRE2GREP OFF CACHE BOOL "" FORCE)
set(PCRE2_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(PCRE2_SUPPORT_JIT OFF CACHE BOOL "" FORCE)
set(PCRE2_SUPPORT_UNICODE ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
FetchContent_Declare(pcre2
    URL "${HIRARI_REGEX_URL}"
    URL_HASH "SHA256=${HIRARI_REGEX_SHA256}"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(pcre2)
