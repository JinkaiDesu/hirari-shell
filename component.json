{
  "schema": "emergence.component/1",
  "id": "hirari",
  "name": "hirari",
  "kind": "product",
  "distribution": "public",
  "version": "0.6.0",
  "description": "Open-source POSIX shell and the Seed language for Windows.",
  "requires": {},
  "versionFiles": [
    {
      "file": "CMakeLists.txt",
      "match": "project\\(Hirari VERSION (?<version>[0-9.]+)",
      "form": "core"
    }
  ],
  "build": [
    {
      "name": "build",
      "run": [
        [
          "cmake",
          "-S",
          "{source}",
          "-B",
          "{build}",
          "-G",
          "Visual Studio 18 2026",
          "-A",
          "x64"
        ],
        [
          "cmake",
          "--build",
          "{build}",
          "--config",
          "Release",
          "--",
          "-m",
          "-nologo",
          "-v:minimal"
        ]
      ]
    }
  ],
  "package": [
    {
      "name": "release folder",
      "run": [
        [
          "cmake",
          "-E",
          "rm",
          "-rf",
          "{build}/package"
        ],
        [
          "cmake",
          "--install",
          "{build}",
          "--config",
          "Release",
          "--component",
          "hirari",
          "--prefix",
          "{build}/package"
        ]
      ]
    },
    {
      "name": "receipt",
      "run": [
        [
          "pwsh",
          "-NoProfile",
          "-File",
          "{path:ci-cd}/tools/receipt.ps1",
          "-Root",
          "{build}/package",
          "-Version",
          "{version}",
          "-Name",
          "hirari"
        ]
      ]
    },
    {
      "name": "archive",
      "run": [
        [
          "pwsh",
          "-NoProfile",
          "-File",
          "{path:ci-cd}/tools/pack.ps1",
          "-From",
          "{build}/package",
          "-To",
          "{out}/hirari-{version}-windows-x64.zip"
        ]
      ]
    },
    {
      "name": "the archive runs on its own",
      "run": [
        [
          "pwsh",
          "-NoProfile",
          "-File",
          "{path:ci-cd}/tests/hirari/release.tests.ps1",
          "-Archive",
          "{out}/hirari-{version}-windows-x64.zip",
          "-Version",
          "{version}"
        ]
      ],
      "expect": "HIRARI_RELEASE_OK"
    }
  ],
  "promotion": "launcher"
}
